[Unit]
Description=Fund Accounting dashboard (gunicorn)
After=network.target mysql.service

[Service]
User=deploy-user
WorkingDirectory=/opt/funding
EnvironmentFile=/opt/funding/.env
Environment=TZ=Asia/Jerusalem
ExecStart=/opt/funding/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 src.web.app:app
Restart=always

[Install]
WantedBy=multi-user.target
