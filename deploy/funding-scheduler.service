[Unit]
Description=Fund Accounting scheduled tasks (prices, FX, snapshots)
After=network.target mysql.service

[Service]
User=deploy-user
WorkingDirectory=/opt/funding
EnvironmentFile=/opt/funding/.env
Environment=TZ=Asia/Jerusalem
ExecStart=/opt/funding/.venv/bin/python scheduler_worker.py
Restart=always

[Install]
WantedBy=multi-user.target
